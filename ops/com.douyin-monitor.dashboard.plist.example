<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.douyin-monitor.dashboard</string>
  <key>WorkingDirectory</key><string>REPLACE_PROJECT_PATH</string>
  <key>ProgramArguments</key><array><string>/usr/bin/env</string><string>npm</string><string>run</string><string>start</string></array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>REPLACE_PROJECT_PATH/artifacts/dashboard.out.log</string>
  <key>StandardErrorPath</key><string>REPLACE_PROJECT_PATH/artifacts/dashboard.err.log</string>
</dict></plist>
